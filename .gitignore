# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test and coverage output
coverage/
.nyc_output/

# Environment — only .env.example is ever committed
.env
.env.*
!.env.example

# Runtime artefacts the service writes: captures, snapshots, baselines, diffs.
# These are page content from real sites and must never reach a public history.
artefacts/
captures/
baselines/
snapshots/

# Browser profile directories. A signed-in profile is a credential.
profiles/
user-data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local tool caches
.cache/
.tmp/
tmp/

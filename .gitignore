# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test and coverage output
coverage/
.nyc_output/

# Environment — only .env.example is ever committed
.env
.env.*
!.env.example

# Runtime artefacts the service writes: captures, snapshots, baselines, diffs.
# These are page content from real sites and must never reach a public history.
artefacts/
captures/
baselines/
snapshots/

# Browser profile directories. A signed-in profile is a credential.
profiles/
user-data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test fixture trees. One case nests a temporary tree inside the repository
# because Node resolves a runtime dependency by walking up to a node_modules,
# and a tree in the system temporary directory has none above it. The case
# removes its own directory; this covers a run that died before it could.
.broker-nomanifest-*/

# The packaging gate's self-test copies the tree once per seeded violation,
# because the gate runs a real `npm pack` and there is no honest way to seed
# one without a real tree. Each seed removes its own directory; this covers a
# run that died before it could.
.check-package-seed-*/

# Local tool caches
.cache/
.tmp/
tmp/
